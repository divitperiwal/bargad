DATABASE_URL=postgres://bargad:bargad@localhost:5432/bargad?sslmode=disable
REDIS_URL=redis://localhost:6379

API_PORT=4000
ENGINE_HEALTH_PORT=8081

# --- API (apps/api) ---
# development, test or production. Production refuses to start without RESEND_API_KEY, with
# RP_ID=localhost, or with a WEB_ORIGIN that is not https.
NODE_ENV=development
# The web app's origin: allowed by CORS and used in links in emails.
WEB_ORIGIN=http://localhost:3000
# Resend API key for sending mail; when unset (not allowed in production) mail is printed to the console.
# RESEND_API_KEY=
# Sender of every email.
MAIL_FROM=Bargad <onboarding@resend.dev>
# WebAuthn relying party id: the site's domain, without scheme or port.
RP_ID=localhost
# Name the browser shows when creating a passkey.
RP_NAME=Bargad
# Comma-separated origins a passkey response may come from; defaults to WEB_ORIGIN.
WEBAUTHN_ORIGINS=http://localhost:3000
# Base64 of the engine's 32-byte public key; broker credentials are sealed to it. Unset disables storing them.
# ENGINE_PUBLIC_KEY=
# Version of that key, stored next to each sealed credential.
ENGINE_KEY_VERSION=1
# fatal, error, warn, info, debug, trace or silent. Logs are JSON lines on stdout; `bun dev` pretty-prints them.
LOG_LEVEL=info
# The rate limiter trusts the first X-Forwarded-For hop as the client address, so the reverse proxy
# (Caddy) must overwrite that header rather than append to it, or clients can choose their own budget.

# --- Engine (apps/engine) --- every value below shows its default.
# Base64 of the engine's 32-byte X25519 private key; its public key is the API's ENGINE_PUBLIC_KEY.
# Only the engine may hold it. Unset turns stored-credential logins off.
# ENGINE_PRIVATE_KEY=
# ENGINE_WORKERS=4                 # job workers; also bounds concurrent broker calls
# ENGINE_JOB_LEASE=60s             # a job not finished within its lease is requeued
# ENGINE_JOB_POLL=5s               # fallback poll when no NOTIFY arrives
# ENGINE_RECONCILE_INTERVAL=15s
# ENGINE_INVARIANT_INTERVAL=1m
# ENGINE_PRICE_SOURCE=fake         # fake, dhan or mstock; empty quotes brokers per order
# ENGINE_PRICE_ACCOUNT_ID=         # broker account (stored credentials) whose session quotes prices; required for dhan/mstock
# ENGINE_VALUATION_INTERVAL=5m     # how often daily_valuations is refreshed during market hours
# ENGINE_PRICE_INTERVAL=1s
# ENGINE_PRICE_MAX_AGE=30s         # older prices are refused by the band check
# ENGINE_WORKER_ID=                # defaults to the hostname
# DHAN_BASE_URL=https://api.dhan.co/v2
# DHAN_AUTH_URL=https://auth.dhan.co
# MSTOCK_BASE_URL=https://api.mstock.trade/openapi/typea
# MSTOCK_API_KEY=                  # the platform key issued by mStock

# Host ports for docker compose, if 5432 or 6379 are already taken (update the URLs too).
# POSTGRES_PORT=5432
# VALKEY_PORT=6379
